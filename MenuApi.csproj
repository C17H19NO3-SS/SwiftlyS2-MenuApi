<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>MenuApi</AssemblyName>
    <RootNamespace>MenuApi</RootNamespace>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="MenuApi.Contract\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MenuApi.Contract\MenuApi.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyContractToExports" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)MenuApi.Contract\bin\Release\net10.0\MenuApi.Contract.dll" DestinationFolder="$(PublishDir)resources\exports\" />
  </Target>

  <Target Name="RemoveRuntimeFolders" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes" />
  </Target>

</Project>
